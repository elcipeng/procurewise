# Salin ke .env lalu isi. Jangan commit file .env.

# URL Postgres dari Neon/Supabase. Format postgresql:// atau postgres:// otomatis
# diubah ke postgresql+asyncpg:// dan sslmode=require diubah ke ssl=require.
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Origin frontend yang boleh akses API, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173

# development atau production
ENVIRONMENT=development

# API key Gemini untuk penjelasan rekomendasi. Kosong berarti penjelasan memakai template
GEMINI_API_KEY=
# model dan batas waktu per percobaan dalam detik, ubah hanya kalau perlu
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
