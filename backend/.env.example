# Salin ke .env lalu isi. Jangan commit file .env.

# URL Postgres dari Neon/Supabase. Format postgresql:// atau postgres:// otomatis
# diubah ke postgresql+asyncpg:// dan sslmode=require diubah ke ssl=require.
DATABASE_URL=postgresql://user:password@localhost:5432/procurewise

# Origin frontend yang boleh akses API, pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173

# development atau production
ENVIRONMENT=development

# Dipakai nanti untuk fitur penjelasan (Gemini), belum dipakai di tahap setup
GEMINI_API_KEY=
